# E2E-переменные (BACK §8.3). Скопируйте в .env в корне репозитория:
#   cp e2e.env.example .env
# Заполните данные и запустите приложение (make run / streamdrop.exe),
# затем: go test ./internal/e2e/ -run MailRu -v

# Учётная запись Mail.ru Cloud (WebDAV): логин и пароль приложения.
MAILRU_USER=
MAILRU_PASS=

# Обычно менять не нужно.
# MAILRU_URL=https://webdav.cloud.mail.ru
# STREAMDROP_URL=http://127.0.0.1:8085
